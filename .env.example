# Speech-to-text
LASS_WHISPER_MODEL=large-v3
LASS_WHISPER_DEVICE=auto
LASS_WHISPER_COMPUTE_TYPE=int8
LASS_STT_TARGET_LUFS=-16

# Embedding and retrieval
LASS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LASS_CHUNK_SIZE=1200
LASS_CHUNK_OVERLAP=150

# Project-local EXAONE 4.0 1.2B
LASS_EXAONE_MODEL_ID=LGAI-EXAONE/EXAONE-4.0-1.2B
LASS_EXAONE_MODEL_DIR=./models/exaone-4.0-1.2b
# Apple Silicon low-memory default (4-bit weights + 8-bit KV cache)
LASS_EXAONE_MLX_MODEL_ID=mlx-community/exaone-4.0-1.2b-4bit
LASS_EXAONE_MLX_MODEL_DIR=./models/exaone-4.0-1.2b-mlx-4bit
LASS_EXAONE_DEVICE=auto
LASS_EXAONE_MAX_NEW_TOKENS=384
LASS_EXAONE_MAX_INPUT_TOKENS=2048
LASS_EXAONE_TEMPERATURE=0.1

# Optional custom paths
# LASS_DATA_DIR=/absolute/path/to/data
# LASS_PROMPT_DIR=/absolute/path/to/prompts
