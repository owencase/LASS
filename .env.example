# Speech-to-text
LASS_WHISPER_MODEL=small
LASS_WHISPER_DEVICE=auto
LASS_WHISPER_COMPUTE_TYPE=int8

# Embedding and retrieval
LASS_EMBEDDING_MODEL=BAAI/bge-m3
LASS_CHUNK_SIZE=1200
LASS_CHUNK_OVERLAP=150

# Local Ollama server
LASS_OLLAMA_BASE_URL=http://localhost:11434
LASS_OLLAMA_MODEL=llama3.1:8b

# Optional custom paths
# LASS_DATA_DIR=/absolute/path/to/data
# LASS_PROMPT_DIR=/absolute/path/to/prompts
